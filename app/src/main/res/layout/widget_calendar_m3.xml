<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:baselineAligned="false"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- بخش بَدج تاریخ بزرگ روز (راست) -->
    <LinearLayout
        android:layout_width="88dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_day_badge_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:id="@+id/widget_day_of_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_today"
            android:textColor="@color/widget_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_day_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_sample_day"
            android:textColor="@color/widget_on_badge"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_month_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_sample_month"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- بخش اطلاعات تقویم و رویدادها (چپ / متن‌های تفصیلی) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_year_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_sample_year"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_other_dates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/widget_sample_other_dates"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_occasion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_sample_occasion"
            android:textColor="@color/widget_primary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_reminders_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_sample_reminders"
            android:textColor="@color/widget_on_surface_low"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
