# SOH3IL Release Keystore Configuration Template
# Copy this file to keystore.properties and fill in your actual production values,
# or set environment variables: KEYSTORE_FILE, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD.
storeFile=signing/release.jks
storePassword=your_keystore_password
keyAlias=your_key_alias
keyPassword=your_key_password
